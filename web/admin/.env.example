# Linktor Admin — environment variables
# Copy to .env.local for development. All NEXT_PUBLIC_* values are inlined at
# build time, so production images must receive them as build args (see
# docker-compose.yml / .github/workflows/build-and-push.yml).

# Base URL of the Linktor API (required in production builds)
NEXT_PUBLIC_API_URL=http://localhost:8081/api/v1

# WebSocket endpoint of the Linktor API (required in production builds)
NEXT_PUBLIC_WS_URL=ws://localhost:8081/api/v1/ws

# Base URL shown when composing webhook URLs in the channel config screens, and
# used to generate the WebChat widget embed snippet (script src + widget baseUrl).
# It must be the PUBLIC origin of the API — where /widget/v1/linktor.js is served
# and where the widget opens its WebSocket (/ws/...) and reads its config
# (/api/v1/webchat/:id/config). Defaults to NEXT_PUBLIC_API_URL without /api/v1.
# In production point it at the real API host, e.g. https://api.linktor.dev
#NEXT_PUBLIC_WEBHOOK_BASE_URL=http://localhost:8081

# Origin the dev-server /api proxy forwards to (next.config.ts rewrites).
# Only used when NEXT_PUBLIC_API_URL is not set.
#NEXT_PROXY_API_ORIGIN=http://localhost:8081

# Render the demo-credentials hint on the login page. Never enable in
# production. (Default: hidden)
#NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=true

# --- Runtime overrides (container env, NOT build args) ------------------------
# The NEXT_PUBLIC_* values above are frozen into the bundle when the image is
# built, which would pin a published image to a single deployment. These three
# override them at runtime: the server re-publishes them to the browser on every
# request (src/lib/runtime-config.ts), so the same image can serve the SaaS and
# an on-prem install. Leave them unset and the build-time values apply.
#
# A value starting with "/" is resolved against whatever host the page was
# opened at — the single-origin form used on-prem, where one reverse proxy
# serves the admin at / and the API at /api, so no hostname or IP has to be
# known at install time. Only the two URLs below accept it; the webhook base is
# displayed on screen and copied into provider consoles, so keep it absolute.
#LINKTOR_ADMIN_API_URL=/api/v1
#LINKTOR_ADMIN_WS_URL=/api/v1/ws
#LINKTOR_ADMIN_WEBHOOK_BASE_URL=http://linktor.local
