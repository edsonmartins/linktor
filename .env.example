# Linktor Environment Configuration
# Copy this file to .env and customize for your environment

# Server
LINKTOR_SERVER_PORT=8081
LINKTOR_SERVER_HOST=0.0.0.0
LINKTOR_SERVER_MODE=debug
LINKTOR_API_PORT=8081
LINKTOR_ADMIN_PORT=3000
LINKTOR_POSTGRES_PORT=5432
LINKTOR_REDIS_PORT=6379
LINKTOR_NATS_PORT=4222
LINKTOR_NATS_MONITOR_PORT=8222
LINKTOR_MINIO_PORT=9000
LINKTOR_MINIO_CONSOLE_PORT=9001

# Database (PostgreSQL)
LINKTOR_DATABASE_HOST=localhost
LINKTOR_DATABASE_PORT=5432
LINKTOR_DATABASE_USER=linktor
LINKTOR_DATABASE_PASSWORD=your-database-password
LINKTOR_DATABASE_DATABASE=linktor
LINKTOR_DATABASE_SSL_MODE=disable

# Redis
LINKTOR_REDIS_HOST=localhost
LINKTOR_REDIS_PORT=6379
LINKTOR_REDIS_PASSWORD=

# NATS
LINKTOR_NATS_URL=nats://localhost:4222
# JetStream replica count for all streams. Keep 1 for a single-node server;
# set 3 (or 5) ONLY when running a NATS cluster of at least that many nodes.
#LINKTOR_NATS_STREAM_REPLICAS=1

# JWT
LINKTOR_JWT_SECRET=change-me-in-production-use-strong-secret

# Auth cookies: tokens are delivered to browsers as HttpOnly cookies.
# cookie_secure requires HTTPS — keep it true in production, set false for
# local http development (otherwise browsers drop the cookie over http).
#LINKTOR_JWT_COOKIE_SECURE=true
# Optional cookie domain to share auth across subdomains (e.g. ".example.com").
#LINKTOR_JWT_COOKIE_DOMAIN=
# SameSite policy: lax (default) | strict | none. App and API on the same
# registrable domain are same-site, so lax works for cross-subdomain calls.
#LINKTOR_JWT_COOKIE_SAME_SITE=lax

# Encryption key for channel credentials at rest (AES-256-GCM).
# Required in release mode: min 32 chars and must differ from the JWT secret.
# Generate with: openssl rand -base64 48
LINKTOR_CRYPTO_ENCRYPTION_KEY=change-me-in-production-use-strong-secret

# Security toggles
# Force webhook signature validation even outside release mode (release mode
# always enforces it).
#LINKTOR_REQUIRE_WEBHOOK_SECRETS=true
# Comma-separated list of allowed CORS origins. Required in production;
# when empty, only localhost origins are accepted (dev fallback).
#LINKTOR_CORS_ALLOWED_ORIGINS=https://app.example.com
# Comma-separated list of origins allowed to open the admin WebSocket.
#LINKTOR_WS_ALLOWED_ORIGINS=https://app.example.com

# Seed demo tenant/user on first boot (development only)
#LINKTOR_SEED_DEMO=true

# Logging
LINKTOR_LOG_LEVEL=debug
LINKTOR_LOG_FORMAT=console

# AI Providers (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=

# Frontend URL
BASE_URL=http://localhost:8081
LINKTOR_BASE_URL=http://localhost:8081

# VRE (visual rendering engine)
# Directory where rendered images are stored. In Docker this must live on a
# volume (docker-compose mounts /app/uploads).
#VRE_UPLOAD_DIR=/app/uploads/vre
# Public base URL for the uploaded renders (default: /uploads/vre)
#VRE_UPLOAD_BASE_URL=
# Directory with VRE HTML templates (default: ./templates)
#VRE_TEMPLATES_PATH=

# Redis connection string override (takes precedence over host/port above)
#REDIS_URL=redis://localhost:6379

# WhatsApp (unofficial/whatsmeow)
# SQLite session storage path; in Docker this lives on the /app/storages volume
#WHATSAPP_DB_PATH=
# App secret used to verify Embedded Signup callbacks
#WHATSAPP_EMBEDDED_SIGNUP_APP_SECRET=

# Admin frontend
NEXT_PUBLIC_API_URL=http://localhost:8081/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8081/api/v1/ws
NEXT_PUBLIC_WEBHOOK_BASE_URL=http://localhost:8081

# Demo credentials
# Email: admin@demo.com
# Password: admin123
